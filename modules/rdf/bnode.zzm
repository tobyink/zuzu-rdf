=cut

from rdf/term import rdf_blank;

class RDFBlankNodeScope {
	let String prefix := "b";
	let Number counter := 0;

	method fresh () {
		counter++;
		return rdf_blank(prefix _ counter);
	}

	method reset () {
		counter := 0;
		return self;
	}
}

function rdf_blank_scope ( String prefix := "b" ) {
	return new RDFBlankNodeScope(prefix: prefix);
}
