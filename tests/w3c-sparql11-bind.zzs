from test/more import *;

author_testing();
requires_capability( "db" );
requires_capability( "fs" );

from rdf import RDFStore, TurtleParser, sparql_query;
from rdf/sparql/w3cresults import sparql_w3c_results_match_file;
from std/db import DB;
from std/io import Path;

let root := new Path("tests/w3c/sparql/sparql11/bind");

if ( not root.child("manifest.ttl").exists() ) {
	pass("W3C SPARQL 1.1 BIND manifest not vendored");
	done_testing();
}

function _store () {
	let store := new RDFStore(dbh: DB.temp());
	store.install_schema();
	( new TurtleParser() ).parse_file(root.child("data.ttl"), into: store);
	return store;
}

function _run ( String query_file ) {
	return sparql_query(
		_store(),
		root.child(query_file).slurp_utf8(),
	);
}

function _matches ( String query_file, String result_file ) {
	return sparql_w3c_results_match_file(
		_run(query_file),
		root.child(result_file),
	);
}

for ( let item in [
	[ "bind01.rq", "bind01.srx" ],
	[ "bind02.rq", "bind02.srx" ],
	[ "bind03.rq", "bind03.srx" ],
	[ "bind04.rq", "bind04.srx" ],
	[ "bind05.rq", "bind05.srx" ],
	[ "bind06.rq", "bind06.srx" ],
	[ "bind07.rq", "bind07.srx" ],
	[ "bind08.rq", "bind08.srx" ],
	[ "bind10.rq", "bind10.srx" ],
	[ "bind11.rq", "bind11.srx" ],
] ) {
	ok(
		_matches( item[0], item[1] ),
		"W3C BIND " _ item[0] _ " exact results",
	);
}

done_testing();
