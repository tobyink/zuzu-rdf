from test/more import *;

author_testing();
requires_capability( "db" );
requires_capability( "fs" );

from rdf import RDFStore, TurtleParser, XSD_NS, sparql_query;
from rdf/sparql/w3cresults import sparql_w3c_results_match_file;
from std/db import DB;
from std/io import Path;

let root := new Path("tests/w3c/sparql/sparql11/project-expression");

if ( not root.child("manifest.ttl").exists() ) {
	pass("W3C SPARQL 1.1 project-expression manifest not vendored");
	done_testing();
}

function _store ( String data_file ) {
	let store := new RDFStore(dbh: DB.temp());
	store.install_schema();
	( new TurtleParser() ).parse_file(root.child(data_file), into: store);
	return store;
}

function _run ( String data_file, String query_file ) {
	return sparql_query(
		_store(data_file),
		root.child(query_file).slurp_utf8(),
	);
}

function _matches ( String data_file, String query_file, String result_file ) {
	return sparql_w3c_results_match_file(
		_run( data_file, query_file ),
		root.child(result_file),
	);
}

let projexp01 := _run( "projexp01.ttl", "projexp01.rq" );
is(
	projexp01{results}.length(),
	2,
	"W3C project-expression equality row count",
);
let equality_values := [];
for ( let row in projexp01{results} ) {
	equality_values.push(row{eq}.get_value());
}
ok(
	"true" in equality_values,
	"W3C project-expression equality includes true row",
);
ok(
	"false" in equality_values,
	"W3C project-expression equality includes false row",
);
ok(
	_matches( "projexp01.ttl", "projexp01.rq", "projexp01.srx" ),
	"W3C project-expression projexp01 exact results",
);
ok(
	_matches( "projexp02.ttl", "projexp02.rq", "projexp02.srx" ),
	"W3C project-expression projexp02 exact results",
);

let projexp03 := _run( "projexp03.ttl", "projexp03.rq" );
is(
	projexp03{results}.length(),
	1,
	"W3C project-expression chained arithmetic row count",
);
is(
	projexp03{results}[0]{sum}.get_value(),
	"3",
	"W3C project-expression addition alias",
);
is(
	projexp03{results}[0]{twice}.get_value(),
	"6",
	"W3C project-expression chained multiplication alias",
);
ok(
	_matches( "projexp03.ttl", "projexp03.rq", "projexp03.srx" ),
	"W3C project-expression projexp03 exact results",
);
ok(
	_matches( "projexp04.ttl", "projexp04.rq", "projexp04.srx" ),
	"W3C project-expression projexp04 exact results",
);

let projexp05 := _run( "projexp05.ttl", "projexp05.rq" );
is(
	projexp05{results}.length(),
	2,
	"W3C project-expression DATATYPE row count",
);
let datatype_seen := false;
let unbound_seen := false;
for ( let row in projexp05{results} ) {
	datatype_seen := true
		if row{dt} != null and row{dt}.get_value() eq XSD_NS _ "integer";
	unbound_seen := true if row{dt} == null;
}
ok(
	datatype_seen,
	"W3C project-expression DATATYPE binds literal datatype",
);
ok(
	unbound_seen,
	"W3C project-expression DATATYPE leaves IRI row unbound",
);
ok(
	_matches( "projexp05.ttl", "projexp05.rq", "projexp05.srx" ),
	"W3C project-expression projexp05 exact results",
);
ok(
	_matches( "projexp06.ttl", "projexp06.rq", "projexp06.srx" ),
	"W3C project-expression projexp06 exact results",
);
ok(
	_matches( "projexp07.ttl", "projexp07.rq", "projexp07.srx" ),
	"W3C project-expression projexp07 exact results",
);

done_testing();
