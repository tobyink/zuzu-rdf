from test/more import *;

author_testing();
requires_capability( "db" );
requires_capability( "fs" );

from rdf import RDFStore, NTriplesParser, TurtleParser, sparql_query;
from rdf/sparql/w3cresults import sparql_w3c_results_match_file;
from std/db import DB;
from std/io import Path;
from std/string import ends_with;

let root := new Path("tests/w3c/sparql/sparql11/functions");

if ( not root.child("manifest.ttl").exists() ) {
	pass("W3C SPARQL 1.1 functions manifest not vendored");
	done_testing();
}

function _store ( String data_file ) {
	let store := new RDFStore(dbh: DB.temp());
	store.install_schema();
	return store if data_file eq "";
	if ( ends_with( data_file, ".nt" ) ) {
		( new NTriplesParser() ).parse_file(root.child(data_file), into: store);
	}
	else {
		( new TurtleParser() ).parse_file(root.child(data_file), into: store);
	}
	return store;
}

function _run ( String data_file, String query_file ) {
	return sparql_query(
		_store(data_file),
		root.child(query_file).slurp_utf8(),
	);
}

function _matches ( String data_file, String query_file, String result_file ) {
	return sparql_w3c_results_match_file(
		_run( data_file, query_file ),
		root.child(result_file),
	);
}

for ( let item in [
	[ "strdt01", "strdt01.rq", "data.ttl", "strdt01.srx" ],
	[ "strdt02", "strdt02.rq", "data.ttl", "strdt02.srx" ],
	[ "strdt03-rdf11", "strdt03.rq", "data.ttl", "strdt03-rdf11.srx" ],
	[ "strlang01", "strlang01.rq", "data.ttl", "strlang01.srx" ],
	[ "strlang02", "strlang02.rq", "data.ttl", "strlang02.srx" ],
	[ "strlang03-rdf11", "strlang03.rq", "data.ttl", "strlang03-rdf11.srx" ],
	[ "isnumeric01", "isnumeric01.rq", "data.ttl", "isnumeric01.srx" ],
	[ "abs01", "abs01.rq", "data.ttl", "abs01.srx" ],
